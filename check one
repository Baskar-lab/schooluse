<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>St. Xavier's International School & AI Smart Campus</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .tab-active { border-bottom: 3px solid #1d4ed8; color: #1d4ed8; font-weight: 700; }
        .glass-panel { background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(12px); }
        .gradient-bg { background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #1e3a8a 100%); }
        .pulse-dot {
            box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
            animation: pulse-green 2s infinite;
        }
        @keyframes pulse-green {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(34, 197, 94, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col">

    <!-- TOP ANNOUNCEMENT BAR -->
    <div class="bg-indigo-950 text-indigo-200 text-xs py-2 px-4 flex justify-between items-center border-b border-indigo-900">
        <div class="flex items-center gap-4 overflow-hidden whitespace-nowrap">
            <span class="bg-amber-500 text-slate-950 font-extrabold px-2 py-0.5 rounded text-[10px] uppercase tracking-wide">Notice</span>
            <span class="truncate">Admissions Open for Academic Year 2026-27 | Annual Science & STEM Expo next Friday!</span>
        </div>
        <div class="hidden md:flex items-center gap-4 shrink-0 text-slate-300">
            <a href="tel:+18005550199" class="hover:text-white transition flex items-center gap-1"><i data-lucide="phone" class="w-3 h-3"></i> +1 (800) 555-0199</a>
            <a href="mailto:info@stxaviers.edu" class="hover:text-white transition flex items-center gap-1"><i data-lucide="mail" class="w-3 h-3"></i> admissions@stxaviers.edu</a>
        </div>
    </div>

    <!-- MAIN NAVBAR -->
    <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <!-- Logo -->
                <div class="flex items-center gap-3 cursor-pointer" onclick="switchTab('public-home')">
                    <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-blue-700 via-indigo-600 to-violet-600 flex items-center justify-center text-white shadow-lg shadow-indigo-500/30">
                        <i data-lucide="graduation-cap" class="w-7 h-7"></i>
                    </div>
                    <div>
                        <h1 class="text-xl font-extrabold tracking-tight text-slate-900">ST. XAVIER'S</h1>
                        <p class="text-xs font-medium text-indigo-600 tracking-widest uppercase">International School</p>
                    </div>
                </div>

                <!-- Desktop Nav Links -->
                <nav class="hidden lg:flex items-center gap-6 font-semibold text-sm text-slate-600">
                    <button onclick="switchTab('public-home')" class="hover:text-indigo-600 transition">Home</button>
                    <button onclick="switchTab('ai-hub')" class="hover:text-indigo-600 transition flex items-center gap-1 text-indigo-600 font-bold">
                        <i data-lucide="sparkles" class="w-4 h-4 text-amber-500"></i> AI Study Hub
                    </button>
                    <button onclick="switchTab('virtual-lab')" class="hover:text-indigo-600 transition flex items-center gap-1">
                        <i data-lucide="flask-conical" class="w-4 h-4 text-emerald-500"></i> STEM Lab
                    </button>
                    <button onclick="switchTab('portal-dashboard')" class="hover:text-indigo-600 transition">Portals</button>
                    <button onclick="switchTab('exam-engine')" class="hover:text-indigo-600 transition">Exams</button>
                    <button onclick="switchTab('bus-tracker')" class="hover:text-indigo-600 transition flex items-center gap-1">
                        <i data-lucide="bus" class="w-4 h-4 text-amber-500"></i> Bus GPS
                    </button>
                    <button onclick="switchTab('library-portal')" class="hover:text-indigo-600 transition">Library</button>
                    <button onclick="switchTab('canteen-portal')" class="hover:text-indigo-600 transition">Canteen</button>
                    <button onclick="switchTab('alumni-portal')" class="hover:text-indigo-600 transition">Alumni</button>
                </nav>

                <!-- Header Actions -->
                <div class="hidden sm:flex items-center gap-3">
                    <button onclick="switchTab('login-page')" class="px-4 py-2 text-sm font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition flex items-center gap-2">
                        <i data-lucide="user" class="w-4 h-4"></i> Sign In
                    </button>
                    <button onclick="switchTab('login-page')" class="px-5 py-2 text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg transition shadow-md shadow-indigo-200">
                        Portal Access
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- CONTENT VIEWS WRAPPER -->
    <main class="flex-grow">

        <!-- 1. PUBLIC HOME PAGE -->
        <section id="public-home" class="view-section">
            <!-- Hero Banner -->
            <div class="gradient-bg text-white relative overflow-hidden py-20 px-4 sm:px-6 lg:px-8">
                <div class="max-w-7xl mx-auto relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                    <div>
                        <div class="inline-flex items-center gap-2 bg-indigo-500/20 border border-indigo-400/30 px-3 py-1.5 rounded-full text-xs font-semibold text-indigo-300 mb-6">
                            <i data-lucide="award" class="w-4 h-4 text-amber-400"></i> Ranked #1 STEM & AI Pioneer School 2026
                        </div>
                        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black leading-tight tracking-tight">
                            Empowering Tomorrow's <span class="bg-gradient-to-r from-amber-300 via-indigo-200 to-cyan-300 bg-clip-text text-transparent">Leaders & Innovators</span>
                        </h1>
                        <p class="mt-6 text-slate-300 text-lg leading-relaxed">
                            Combining rigorous academic excellence, state-of-the-art AI-powered personalized tutoring, interactive STEM labs, and holistic character building for K-12 education.
                        </p>
                        <div class="mt-8 flex flex-wrap gap-4">
                            <button onclick="switchTab('ai-hub')" class="px-6 py-3.5 bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold rounded-xl shadow-lg transition flex items-center gap-2">
                                <i data-lucide="sparkles" class="w-5 h-5"></i> Try AI Doubt Solver
                            </button>
                            <button onclick="switchTab('virtual-lab')" class="px-6 py-3.5 bg-white/10 hover:bg-white/20 border border-white/20 font-bold rounded-xl backdrop-blur transition flex items-center gap-2">
                                <i data-lucide="flask-conical" class="w-5 h-5 text-emerald-400"></i> Launch STEM Lab
                            </button>
                        </div>
                    </div>
                    <div class="relative">
                        <div class="bg-slate-900/80 border border-indigo-500/30 rounded-2xl p-6 backdrop-blur-xl shadow-2xl">
                            <div class="flex items-center justify-between pb-4 border-b border-slate-800">
                                <div class="flex items-center gap-3">
                                    <div class="w-3 h-3 rounded-full bg-red-500"></div>
                                    <div class="w-3 h-3 rounded-full bg-amber-500"></div>
                                    <div class="w-3 h-3 rounded-full bg-green-500"></div>
                                    <span class="text-xs text-slate-400 font-mono">Live AI Learning Hub</span>
                                </div>
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-green-500/20 text-green-400 border border-green-500/30">Active System</span>
                            </div>
                            <div class="mt-4 space-y-4">
                                <div class="bg-slate-800/80 p-4 rounded-xl border border-slate-700">
                                    <p class="text-xs text-slate-400 font-semibold mb-1">Interactive Feature Highlights</p>
                                    <div class="grid grid-cols-2 gap-2 text-xs font-semibold text-slate-200">
                                        <div class="p-2 bg-slate-900/50 rounded flex items-center gap-2"><i data-lucide="check-circle" class="text-green-400 w-4 h-4"></i> AI 24/7 Doubt Solver</div>
                                        <div class="p-2 bg-slate-900/50 rounded flex items-center gap-2"><i data-lucide="check-circle" class="text-green-400 w-4 h-4"></i> Live Video Classes</div>
                                        <div class="p-2 bg-slate-900/50 rounded flex items-center gap-2"><i data-lucide="check-circle" class="text-green-400 w-4 h-4"></i> GPS Bus Tracking</div>
                                        <div class="p-2 bg-slate-900/50 rounded flex items-center gap-2"><i data-lucide="check-circle" class="text-green-400 w-4 h-4"></i> Virtual Physics/Chem Lab</div>
                                    </div>
                                </div>
                                <button onclick="switchTab('login-page')" class="w-full py-3 bg-indigo-600 hover:bg-indigo-500 font-bold rounded-xl text-center text-sm transition">
                                    Access Student & Staff Portals &rarr;
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- School Features Overview Grid -->
            <div class="max-w-7xl mx-auto px-4 py-16 sm:px-6 lg:px-8">
                <div class="text-center max-w-2xl mx-auto mb-12">
                    <h2 class="text-3xl font-extrabold text-slate-900">Integrated Smart Campus Features</h2>
                    <p class="text-slate-600 mt-2">Explore the tools available for students, teachers, parents, and administrative staff.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <!-- Card 1 -->
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 hover:shadow-md transition">
                        <div class="w-12 h-12 rounded-xl bg-indigo-100 text-indigo-600 flex items-center justify-center mb-4">
                            <i data-lucide="sparkles" class="w-6 h-6"></i>
                        </div>
                        <h3 class="text-lg font-bold text-slate-900 mb-2">AI Academic Assistant</h3>
                        <p class="text-sm text-slate-600 leading-relaxed mb-4">Instant doubt resolution in Physics, Math, Chemistry, and Humanities with step-by-step guidance.</p>
                        <button onclick="switchTab('ai-hub')" class="text-indigo-600 font-bold text-sm hover:underline">Open AI Hub &rarr;</button>
                    </div>
                    <!-- Card 2 -->
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 hover:shadow-md transition">
                        <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center mb-4">
                            <i data-lucide="flask-conical" class="w-6 h-6"></i>
                        </div>
                        <h3 class="text-lg font-bold text-slate-900 mb-2">Virtual Science Labs</h3>
                        <p class="text-sm text-slate-600 leading-relaxed mb-4">Simulate physical pendulum experiments, acid-base chemistry titrations, and cell structures in real-time.</p>
                        <button onclick="switchTab('virtual-lab')" class="text-emerald-600 font-bold text-sm hover:underline">Explore Experiments &rarr;</button>
                    </div>
                    <!-- Card 3 -->
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 hover:shadow-md transition">
                        <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center mb-4">
                            <i data-lucide="bus" class="w-6 h-6"></i>
                        </div>
                        <h3 class="text-lg font-bold text-slate-900 mb-2">Real-time GPS Fleet Tracking</h3>
                        <p class="text-sm text-slate-600 leading-relaxed mb-4">Parents can track school bus routes live on interactive maps with emergency SOS notifications.</p>
                        <button onclick="switchTab('bus-tracker')" class="text-amber-600 font-bold text-sm hover:underline">Track Bus Location &rarr;</button>
                    </div>
                </div>
            </div>
        </section>

        <!-- 2. LOGIN / PORTAL ACCESSS -->
        <section id="login-page" class="view-section hidden py-16 px-4">
            <div class="max-w-md mx-auto bg-white border border-slate-200 rounded-2xl p-8 shadow-xl">
                <div class="text-center mb-6">
                    <div class="w-12 h-12 bg-indigo-600 text-white rounded-xl flex items-center justify-center mx-auto mb-3">
                        <i data-lucide="lock" class="w-6 h-6"></i>
                    </div>
                    <h2 class="text-2xl font-bold text-slate-900">Campus Portal Access</h2>
                    <p class="text-slate-500 text-xs mt-1">Select your role to view demo dashboards</p>
                </div>

                <div class="grid grid-cols-2 gap-2 bg-slate-100 p-1 rounded-xl mb-6 font-semibold text-xs text-center">
                    <button onclick="setLoginRole('student')" id="btn-role-student" class="py-2.5 rounded-lg bg-white shadow text-indigo-600">Student / Parent</button>
                    <button onclick="setLoginRole('teacher')" id="btn-role-teacher" class="py-2.5 rounded-lg text-slate-600 hover:bg-slate-200">Teacher / Staff</button>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase mb-1">User ID / Email</label>
                        <input id="login-id" type="text" value="STU-2026-889" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 outline-none text-sm font-medium">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Password</label>
                        <input type="password" value="••••••••••••" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 outline-none text-sm font-medium">
                    </div>
                    <button onclick="performLogin()" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl transition shadow-md">
                        Login to Portal
                    </button>
                </div>

                <div class="mt-6 pt-6 border-t border-slate-100 text-center">
                    <p class="text-xs text-slate-500 mb-2">Instant Quick Demo Buttons:</p>
                    <div class="flex justify-center gap-2">
                        <button onclick="demoLogin('student')" class="px-3 py-1.5 bg-indigo-50 text-indigo-700 text-xs font-bold rounded-lg hover:bg-indigo-100">Demo Student</button>
                        <button onclick="demoLogin('teacher')" class="px-3 py-1.5 bg-emerald-50 text-emerald-700 text-xs font-bold rounded-lg hover:bg-emerald-100">Demo Teacher</button>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. AI STUDY HUB & DOUBT SOLVER -->
        <section id="ai-hub" class="view-section hidden py-10 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
            <div class="mb-8">
                <span class="px-3 py-1 bg-indigo-100 text-indigo-700 rounded-full text-xs font-extrabold uppercase tracking-wide">AI Learning Hub</span>
                <h2 class="text-3xl font-extrabold text-slate-900 mt-2">Xavier AI Tutor & Instant Doubt Solver</h2>
                <p class="text-slate-600 text-sm">Ask questions, generate practice quizzes, or request step-by-step math & science breakdowns.</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- AI Query Box -->
                <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 p-6 shadow-sm flex flex-col justify-between">
                    <div>
                        <div class="flex items-center gap-3 pb-4 border-b border-slate-100">
                            <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-amber-400 to-indigo-600 text-white flex items-center justify-center font-bold">
                                <i data-lucide="sparkles" class="w-5 h-5"></i>
                            </div>
                            <div>
                                <h3 class="font-bold text-slate-900">Ask Xavier AI</h3>
                                <p class="text-xs text-slate-500">Powered by educational knowledge models</p>
                            </div>
                        </div>

                        <div id="ai-response-box" class="mt-6 bg-slate-50 border border-slate-200 rounded-xl p-5 min-h-[200px] text-sm text-slate-700">
                            <p class="text-slate-400 italic">Example prompt: "Explain Newton's Second Law with real-world sports
